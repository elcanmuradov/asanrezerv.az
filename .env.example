# Bu faylı .env kimi kopyala və dəyərləri doldur:  cp .env.example .env

# PostgreSQL
POSTGRES_USER=rezervet
POSTGRES_PASSWORD=rezervet

# JWT imza açarı — auth-service və api-gateway EYNİ dəyəri istifadə etməlidir.
# Prod-da uzun, təsadüfi bir dəyər qoy (məs: openssl rand -hex 64).
JWT_

# AI narrative (Level 2) — Claude API açarı. Boş qalsa AI statistik işləyir, LLM bağlıdır.
ANTHROPIC_API_KEY=
